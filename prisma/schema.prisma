generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Roles {
  admin
  moderator
  user
}

//! todo: create the columns createdAt and updatedAt
model User {
  id       String  @id @default(uuid())
  name     String
  lastname String
  email    String  @unique
  password String
  role     Roles

  @@index([email])
  @@map("users")
}

enum StatusLead {
  unattended
  attended
}

model Lead {
  id          String      @id @default(uuid())
  name        String
  lastname    String
  email       String
  phoneNumber String?
  zipcode     String?
  comments    String?     @db.Text
  status      StatusLead  @default(unattended)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("leads")
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  imagePath String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("brands")
}
