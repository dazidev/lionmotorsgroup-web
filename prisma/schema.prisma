// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Roles {
  admin
  moderator
  user
}

//! todo: create the columns createdAt and updatedAt
model User {
  id       String  @id @default(uuid())
  name     String
  lastname String
  email    String  @unique
  password String
  role     Roles

  @@index([email])
  @@map("users")
}

enum StatusLead {
  unattended
  attended
}

enum TypeLead {
  vehicle
  general
}

model Lead {
  id          String           @id @default(uuid())
  name        String
  lastname    String
  email       String
  phoneNumber String?
  zipcode     String?
  comments    String?          @db.Text
  status      StatusLead       @default(unattended)
  type        TypeLead
  vehicleId   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  vehicle     VehicleGeneral? @relation(fields: [vehicleId], references: [id])

  @@map("leads")
}

model Brand {
  id        String            @id @default(uuid())
  name      String
  imagePath String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  vehicles  VehicleGeneral[]

  @@map("brands")
}

enum StatusVehicle {
  in_stock
  on_sale
  sold
}

model VehicleGeneral {
  id             String                                   @id @default(uuid())
  shortId        String?                                  @unique
  vin            String                                   @unique
  slug           String
  year           Int
  brandId        String
  model          String
  series         String
  doors          Int
  colorExt       String                 @map("color_ext")
  colorInt       String?                @map("color_int")
  mileage        Int
  price          Int
  status         StatusVehicle
  type           String
  investment     Int
  createdAt      DateTime                                 @default(now())
  updatedAt      DateTime                                 @updatedAt

  brand          Brand                  @relation(fields: [brandId], references: [id])
  technical      VehicleTechnical?
  images         VehicleImage[]
  specifications VehicleSpecification[]
  leads          Lead[]
  investments    VehicleInvestment[]

  @@unique([slug, shortId])
  @@map("vehicles_general")
}

enum FuelType {
  gasoline
  diesel
  hybrid
  electric
  gas
}

enum DrivetrainType {
  FOUR_X_FOUR @map("4x4")
  FOUR_X_TWO  @map("4x2")
}

enum TransmissionType {
  automatic
  manual
}

model VehicleTechnical {
  vehicleId           String                                        @id
  engineFuelType      FuelType         @map("engine_fuel_type")
  engineConfiguration String           @map("engine_configuration")
  engineCylinders     Int              @map("engine_cylinders")
  enginePower         Int              @map("engine_power")
  engineDisplacement  Float            @map("engine_displacement")
  engineTurbo         String           @map("engine_turbo")
  drivetrain          DrivetrainType
  transmission        TransmissionType
  createdAt           DateTime                                      @default(now())
  updatedAt           DateTime                                      @updatedAt

  vehicle             VehicleGeneral   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicles_technical")
}

model VehicleImage {
  id        String          @id @default(uuid())
  vehicleId String
  key       String
  position  Int

  vehicle   VehicleGeneral @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_images")
}

enum TypeSpecification {
  security
  confort
  visual
}

model Specification {
  id        String                  @id @default(uuid())
  type      TypeSpecification
  name      String
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  vehicles  VehicleSpecification[]

  @@index([type])
  @@map("specifications")
}

model VehicleSpecification {
  vehicleId       String
  specificationId String

  vehicle         VehicleGeneral @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  specification   Specification  @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  @@id([vehicleId, specificationId])
  @@index([vehicleId])
  @@index([specificationId])
  @@map("vehicle_specifications")
}

model VehicleInvestment {
  id          String          @id @default(uuid())
  vehicleId   String
  name        String
  amount      Int
  description String
  invoiceKey  String
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  vehicle     VehicleGeneral @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_investment")
}

model Reviews {
  id        String    @id @default(uuid())
  name      String
  rating    Int
  comment   String?
  CreatedAt DateTime  @default(now())

  @@map("reviews")
}