// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Roles {
  admin
  moderator
  user
}

//! todo: create the columns createdAt and updatedAt
model User {
  id       String  @id @default(uuid())
  name     String
  lastname String
  email    String  @unique
  password String
  role     Roles

  @@index([email])
  @@map("users")
}

enum StatusLead {
  unattended
  attended
}

model Lead {
  id          String          @id @default(uuid())
  name        String
  lastname    String
  email       String
  phoneNumber String?
  zipcode     String?
  comments    String?         @db.Text
  status      StatusLead      @default(unattended)
  vehicleId   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  vehicle     VehicleGeneral @relation(fields: [vehicleId], references: [id])

  @@map("leads")
}

model Brand {
  id        String            @id @default(uuid())
  name      String
  imagePath String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  vehicles  VehicleGeneral[]

  @@map("brands")
}

enum StatusVehicle {
  in_stock
  on_sale
  sold
}

model VehicleGeneral {
  id             String                  @id @default(uuid())
  shortId        String?                 @unique
  vin            String                  @unique
  slug           String
  year           Int
  brandId        String
  model          String
  series         String
  doors          Int
  color_ext      String
  color_int      String
  mileage        Int
  price          Int
  status         StatusVehicle
  type           String
  investment     Int
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  brand          Brand                  @relation(fields: [brandId], references: [id])
  technical      VehicleTechnical?
  images         VehicleImage[]
  specifications VehicleSpecification[]
  leads          Lead[]
  investments    VehicleInvestment[]

  @@unique([slug, shortId])
  @@map("vehicles_general")
}

model VehicleTechnical {
  vehicleId            String          @id
  engine_fuel_type     String
  engine_configuration String
  engine_cylinders     Int
  engine_power         Int
  engine_displacement  Float
  engine_turbo         String
  drivetrain           String
  transmission         String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  vehicle              VehicleGeneral @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicles_technical")
}

model VehicleImage {
  id        String          @id @default(uuid())
  vehicleId String
  key       String
  position  Int

  vehicle   VehicleGeneral @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_images")
}

enum TypeSpecification {
  security
  confort
}

model Specification {
  id        String                  @id @default(uuid())
  type      TypeSpecification
  name      String
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  vehicles  VehicleSpecification[]

  @@index([type])
  @@map("specifications")
}

model VehicleSpecification {
  vehicleId       String
  specificationId String

  vehicle         VehicleGeneral @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  specification   Specification  @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  @@id([vehicleId, specificationId])
  @@index([vehicleId])
  @@index([specificationId])
  @@map("vehicle_specifications")
}

model VehicleInvestment {
  id          String          @id @default(uuid())
  vehicleId   String
  amount      Int
  description String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  vehicle     VehicleGeneral @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_investment")
}